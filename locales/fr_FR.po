msgid "SecureScan"
msgstr "SecureScan"

msgid "Analyze every file before it is published using the server antivirus."
msgstr "Analyse chaque fichier avant sa publication à l’aide de l’antivirus du serveur."

msgid "Enable scanning before publishing"
msgstr "Activer l’analyse avant la publication"

msgid "The file remains temporary until the antivirus returns a clean result."
msgstr "Le fichier reste temporaire jusqu’à ce que l’antivirus renvoie un résultat sain."

msgid "Scan command"
msgstr "Commande d’analyse"

msgid "Use {file} as the temporary file placeholder. Default: clamdscan --no-summary {file}."
msgstr "Utilisez {file} comme emplacement du fichier temporaire. Par défaut : clamdscan --no-summary {file}."

msgid "For security, separators, redirects, substitutions, comments, and shell operators are not allowed."
msgstr "Pour des raisons de sécurité, les séparateurs, redirections, substitutions, commentaires et opérateurs shell ne sont pas autorisés."

msgid "Test antivirus"
msgstr "Tester l’antivirus"

msgid "Unable to create the temporary test file."
msgstr "Impossible de créer le fichier temporaire de test."

msgid "SecureScan could not access the temporary file."
msgstr "SecureScan n’a pas pu accéder au fichier temporaire."

msgid "SecureScan requires the PHP exec() function to be available."
msgstr "SecureScan nécessite que la fonction PHP exec() soit disponible."

msgid "The antivirus command must contain the {file} placeholder."
msgstr "La commande antivirus doit contenir l’emplacement {file}."

msgid "The command contains forbidden characters or operators."
msgstr "La commande contient des caractères ou opérateurs interdits."

msgid "SecureScan could not find the antivirus executable for the PHP process. Verify the command path and the web server/PHP user permissions."
msgstr "SecureScan n’a pas pu trouver l’exécutable de l’antivirus pour le processus PHP. Vérifiez le chemin de la commande et les autorisations de l’utilisateur du serveur web/PHP."

msgid "The antivirus responded successfully and the test file is clean."
msgstr "L’antivirus a répondu correctement et le fichier de test est sain."

msgid "The antivirus detected a threat. The file was rejected."
msgstr "L’antivirus a détecté une menace. Le fichier a été rejeté."

msgid "SecureScan could not complete the antivirus scan (code %d). The file was rejected."
msgstr "SecureScan n’a pas pu terminer l’analyse antivirus (code %d). Le fichier a été rejeté."

msgid "The antivirus command cannot be empty."
msgstr "La commande antivirus ne peut pas être vide."

msgid "SecureScan configuration could not be saved."
msgstr "La configuration de SecureScan n’a pas pu être enregistrée."

msgid "SecureScan configuration saved successfully."
msgstr "La configuration de SecureScan a été enregistrée avec succès."

msgid "Unable to write the temporary test file."
msgstr "Impossible d’écrire le fichier temporaire de test."

msgid "SecureScan could not locate the temporary uploaded file."
msgstr "SecureScan n’a pas pu localiser le fichier temporaire téléversé."

msgid "Run Test antivirus successfully before enabling scanning."
msgstr "Exécutez correctement Tester l’antivirus avant d’activer l’analyse."

msgid "You must run Test antivirus successfully for the current command before enabling scanning."
msgstr "Vous devez exécuter correctement Tester l’antivirus pour la commande actuelle avant d’activer l’analyse."

msgid "Run Test antivirus successfully for the current command before enabling scanning."
msgstr "Exécutez correctement Tester l’antivirus pour la commande actuelle avant d’activer l’analyse."

msgid "The antivirus test succeeded, but SecureScan could not save the test result."
msgstr "Le test antivirus a réussi, mais SecureScan n’a pas pu enregistrer le résultat du test."

msgid "Document scan results are recorded in GLPI file log: files/_log/securescan.log. File contents are never logged."
msgstr "Les résultats des analyses de documents sont enregistrés dans le journal de fichiers de GLPI : files/_log/securescan.log. Le contenu des fichiers n’est jamais enregistré."

msgid "Go to logs"
msgstr "Accéder aux journaux"

msgid "SecureScan: file scanned successfully and stored. Result: clean. SHA-256: %s"
msgstr "SecureScan : fichier analysé avec succès et enregistré. Résultat : sain. SHA-256 : %s"

msgid "SecureScan: file scanned and stored. Result: %s. SHA-256: %s"
msgstr "SecureScan : fichier analysé et enregistré. Résultat : %s. SHA-256 : %s"

msgid "A new SecureScan version is available."
msgstr "Une nouvelle version de SecureScan est disponible."

msgid "installed"
msgstr "installée"

msgid "View release"
msgstr "Voir la version"

msgid "SecureScan is up to date."
msgstr "SecureScan est à jour."

msgid "Latest stable"
msgstr "Dernière version stable"

msgid "View releases"
msgstr "Voir les versions"

msgid "GitHub version check is currently unavailable."
msgstr "La vérification de version GitHub est actuellement indisponible."
